{
  "name": "signet-mcp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --import tsx src/app/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/service/mcp/src/app/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:postgres": "ENABLE_POSTGRES_E2E=1 vitest run tests/e2e/postgres-persistence.test.ts",
    "create-api-key": "node --import tsx scripts/create-api-key.ts",
    "registry-ingest": "node --import tsx scripts/registry-ingest.ts"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.1173.0",
    "@aws-sdk/client-s3": "^3.1168.0",
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@okta/jwt-verifier": "^4.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.2",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "hono": "^4.13.18",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "rdf-canonize": "^5.0.0",
    "re2js": "^2.10.0",
    "snowflake-sdk": "^3.4.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.0",
    "@tootallnate/once": "^2.0.1",
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9",
    "follow-redirects": "^1.16.2",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "tar": "^7.5.21",
    "uuid": "^11.1.1"
  }
}
