NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
PORT=3000

# Stage 1 defaults for local development
AUTH_MODE=api_key
OKTA_MODE=mock

# Keep connectors mocked locally unless explicitly testing real integrations
SNOWFLAKE_MODE=mock
ATHENA_MODE=mock
MOTHERDUCK_MODE=mock

# Local shared paths (inside container)
DATABASE_URL=file:/workspace/data/mcp/signet-mcp.db
REGISTRY_GRAPH_BACKEND=json_file
REGISTRY_GRAPH_STATE_FILE=/workspace/data/registry/graph/registry-state.json
REGISTRY_ARTIFACT_BACKEND=fs
REGISTRY_OBJECTS_DIR=/workspace/data/registry/objects

# Safety defaults
MAX_ROWS_DEFAULT=50
MAX_ROWS_HARD_MAX=500
TOOL_TIMEOUT_MS_DEFAULT=15000
TOOL_TIMEOUT_MS_HARD_MAX=60000
MAX_OUTPUT_BYTES=65536

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
