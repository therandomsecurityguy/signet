NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
PORT=3000

# Stage 1 defaults for local development
AUTH_MODE=api_key
OKTA_MODE=mock

# Keep connectors mocked locally unless explicitly testing real integrations
SNOWFLAKE_MODE=mock
ATHENA_MODE=mock
MOTHERDUCK_MODE=mock

# Local shared paths (inside container)
DATABASE_URL=file:/workspace/data/mcp/signet-mcp.db
REGISTRY_GRAPH_BACKEND=json_file
REGISTRY_GRAPH_STATE_FILE=/workspace/data/registry/graph/registry-state.json
REGISTRY_ARTIFACT_BACKEND=fs
REGISTRY_OBJECTS_DIR=/workspace/data/registry/objects

# Safety defaults
MAX_ROWS_DEFAULT=50
MAX_ROWS_HARD_MAX=500
TOOL_TIMEOUT_MS_DEFAULT=15000
TOOL_TIMEOUT_MS_HARD_MAX=60000
MAX_OUTPUT_BYTES=65536

# Rate limiting (enabled by default)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Optional SPARQL backend (for live Fuseki integration)
# REGISTRY_GRAPH_BACKEND=sparql
# REGISTRY_SPARQL_QUERY_URL=http://registry-graph:3030/registry/sparql
# REGISTRY_SPARQL_UPDATE_URL=http://registry-graph:3030/registry/update
# REGISTRY_SPARQL_USERNAME=admin
# REGISTRY_SPARQL_PASSWORD=admin

# Optional S3-backed artifact CAS
# REGISTRY_ARTIFACT_BACKEND=s3
# REGISTRY_S3_BUCKET=signet-artifacts
# REGISTRY_S3_PREFIX=signet/dev
# REGISTRY_S3_REGION=us-west-2
# REGISTRY_S3_ENDPOINT=http://minio:9000
# REGISTRY_S3_FORCE_PATH_STYLE=true
# REGISTRY_S3_ACCESS_KEY_ID=minio
# REGISTRY_S3_SECRET_ACCESS_KEY=change-me

# Optional Tessera companion hint
# TESSERA_SIDECAR_URL=http://tessera-sidecar:3400
