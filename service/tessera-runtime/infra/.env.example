HOST=0.0.0.0
PORT=2024
TESSERA_AWS_REGION=us-west-2

# Shared bucket from the registry+tessera Terraform seam
# The easiest operator path is:
# cd agents-registry/infra && make wire-tessera-aws
TESSERA_BUCKET=agents-registry-artifacts

# Local MySQL-compatible state for Tessera AWS backend
TESSERA_DB_NAME=tessera
TESSERA_DB_HOST=tessera-db
TESSERA_DB_PORT=3306
TESSERA_DB_USER=tessera
TESSERA_DB_PASSWORD=tessera-dev-change-me

# Optional AWS production-style secret indirection
# TESSERA_DB_SECRET_ARN=arn:aws:secretsmanager:us-west-2:123456789012:secret:agents-registry/tessera-db

# Optional S3-compatible endpoint for local/non-AWS testing
# TESSERA_S3_ENDPOINT=http://minio:9000
# TESSERA_S3_ACCESS_KEY_ID=minio
# TESSERA_S3_SECRET_ACCESS_KEY=change-me
# TESSERA_S3_FORCE_PATH_STYLE=true

# Optional stable signer
# TESSERA_LOG_PRIVATE_KEY=<go-sumdb-note-signer>
TESSERA_LOG_NAME=agents-registry-dev
TESSERA_PUBLISH_INTERVAL=3s
TESSERA_CHECKPOINT_REPUBLISH_INTERVAL=30s
