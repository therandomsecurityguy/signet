{
  "name": "signet-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --import tsx src/app/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/service/api/src/app/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:live-sparql": "ENABLE_LIVE_SPARQL_E2E=1 vitest run tests/e2e/api-sparql-live.test.ts",
    "test:postgres": "ENABLE_POSTGRES_E2E=1 vitest run tests/e2e/postgres-persistence.test.ts",
    "create-api-key": "node --import tsx scripts/create-api-key.ts",
    "dump-openapi": "node --import tsx scripts/dump-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@hono/node-server": "^2.1.11",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "@okta/jwt-verifier": "^4.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.2",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "hono": "^4.13.20",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "rdf-canonize": "^5.0.0",
    "re2js": "^2.10.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "tar": "^7.5.21",
    "@tootallnate/once": "^2.0.1",
    "uuid": "^11.1.1"
  }
}
