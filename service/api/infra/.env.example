NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
PORT=3100
DATABASE_URL=file:/workspace/data/api/signet-api.db
AUTH_MODE=api_key
OKTA_MODE=mock
REGISTRY_GRAPH_BACKEND=json_file
REGISTRY_GRAPH_STATE_FILE=/workspace/data/registry/graph/registry-state.json
REGISTRY_ARTIFACT_BACKEND=fs
REGISTRY_OBJECTS_DIR=/workspace/data/registry/objects

# Rate limiting (enabled by default)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Optional SPARQL backend (for live Fuseki integration)
# REGISTRY_GRAPH_BACKEND=sparql
# REGISTRY_SPARQL_QUERY_URL=http://registry-graph:3030/registry/sparql
# REGISTRY_SPARQL_UPDATE_URL=http://registry-graph:3030/registry/update
# REGISTRY_SPARQL_USERNAME=admin
# REGISTRY_SPARQL_PASSWORD=admin

# Optional S3-backed artifact CAS
# The easiest operator path is:
# cd signet/infra && make wire-tessera-aws
# REGISTRY_ARTIFACT_BACKEND=s3
# REGISTRY_S3_BUCKET=signet-artifacts
# REGISTRY_S3_PREFIX=signet/dev
# REGISTRY_S3_REGION=us-west-2
# REGISTRY_S3_ENDPOINT=http://minio:9000
# REGISTRY_S3_FORCE_PATH_STYLE=true
# REGISTRY_S3_ACCESS_KEY_ID=minio
# REGISTRY_S3_SECRET_ACCESS_KEY=change-me

# Optional Tessera companion hint
# The same `make wire-tessera-aws` target can write these too.
# TESSERA_SIDECAR_URL=http://tessera-sidecar:3400
# TRANSPARENCY_APPEND_LOG_ID=registry-governance-dev
# Reconcile against the companion log's checkpoint key: the spec verifier key
# (`<name>+<hash8hex>+<base64>`, Ed25519) or the legacy PEM (not both).
# TESSERA_LOG_NOTE_VERIFIER=signet-tessera.local+98864f5a+A...
# TESSERA_LOG_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Optional SHACL-AF runtime sidecar (docker compose profile: shacl-af).
# Policies using SHACL rules, SPARQL functions, or custom SPARQL-based
# constraint components fail closed validation unless this is configured.
# SHACL_RUNTIME_URL=http://shacl-runtime:3300
# SHACL_RUNTIME_TOKEN=

# Optional real Okta mode
# AUTH_MODE=okta
# OKTA_MODE=real
# OKTA_ISSUER=https://your-okta-domain/oauth2/default
# OKTA_AUDIENCE=api://default
# OKTA_REQUIRED_SCOPES=registry.write
