# SHACL-AF runtime sidecar (optional; executes pyshacl advanced features:
# rules, SPARQL functions, custom SPARQL-based constraint components).
HOST=0.0.0.0
PORT=3300

# When set, /v1/validate requires this exact bearer token. Leave empty for
# local development; the registry must present the same value via its
# SHACL_RUNTIME_TOKEN configuration. Never commit a real token.
SHACL_RUNTIME_TOKEN=

VALIDATE_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT_SECONDS=15
# MAX_BODY_BYTES=2000000
# MAX_CONCURRENCY=4
# QUEUE_LIMIT=32

# Worker subprocess rlimits: memory cap (enforced on Linux; best-effort where
# the kernel rejects RLIMIT_AS), cumulative CPU backstop, FD cap.
# MAX_MEMORY_MB=1024
# MAX_CPU_SECONDS=300
# MAX_NOFILE=64
