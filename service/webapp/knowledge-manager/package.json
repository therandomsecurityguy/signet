{
  "name": "signet-knowledge-manager",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --import tsx src/server/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:interactions": "ENABLE_INTERACTION_E2E=1 vitest run tests/interaction",
    "demo:mock-okta": "node --import tsx scripts/mock-okta-demo.ts",
    "demo:video": "node --import tsx scripts/demo-video.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@picocss/pico": "^2.1.1",
    "cytoscape": "^3.35.0",
    "hono": "^4.13.20",
    "pino": "^10.4.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "tar": "^7.5.21",
    "@tootallnate/once": "^2.0.1"
  }
}
