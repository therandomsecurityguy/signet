NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
PORT=3200
API_ORIGIN=http://api:3100
VOCBENCH_UI_URL=http://vocbench:1979/vocbench3
DATABASE_URL=file:/workspace/data/webapp/knowledge-manager.db
AUTH_MODE=api_key
OKTA_MODE=mock
OKTA_REDIRECT_URI=http://localhost:3200/session/callback
OKTA_SCOPES=openid profile email
SESSION_COOKIE_NAME=knowledge_manager_session
SESSION_TTL_MINUTES=480

# Required only when AUTH_MODE is okta or dual and OKTA_MODE=real.
# OKTA_ISSUER=https://your-org.okta.com/oauth2/default
# OKTA_CLIENT_ID=your-webapp-client-id

# Optional Semantic Turkey API integration (read-only thin companion path)
# Base URL should include the Semantic Turkey core services root.
# Example:
# SEMANTIC_TURKEY_BASE_URL=http://vocbench:1979/semanticturkey/it.uniroma2.art.semanticturkey/st-core-services
# SEMANTIC_TURKEY_EMAIL=admin@example.org
# SEMANTIC_TURKEY_PASSWORD=change-me
