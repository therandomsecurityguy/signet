NODE_ENV=development
HOST=0.0.0.0
PORT=3400

# Shared S3 location for Tessera companion work
# The easiest operator path is:
# cd signet/infra && make wire-tessera-aws
TESSERA_SIDECAR_BUCKET=signet-artifacts
TESSERA_SIDECAR_REGION=us-west-2
TESSERA_SIDECAR_TILES_PREFIX=tessera/tiles/dev
TESSERA_SIDECAR_REQUESTS_PREFIX=tessera/requests/dev
TESSERA_RUNTIME_ADD_URL=http://tessera-runtime:2024/v1/entries

# Optional S3-compatible endpoint for local/non-AWS testing
# TESSERA_SIDECAR_AWS_ENDPOINT=http://minio:9000
# TESSERA_SIDECAR_FORCE_PATH_STYLE=true
# TESSERA_SIDECAR_AWS_ACCESS_KEY_ID=minio
# TESSERA_SIDECAR_AWS_SECRET_ACCESS_KEY=change-me
