@prefix sh: <http://www.w3.org/ns/shacl#> .

# Template: sbom-required
#
# A gate policy: certifying a version is blocked unless a verified SBOM
# attestation (DSSE/in-toto, ingested through POST /v1/attestations) is
# attached to the publication.
#
# The shapes slot is required for every authored policy; this starts with a
# no-op shape — replace or extend it with real constraints as the policy
# grows.
#
# Register with:
#   POST /v1/policy-packages
#   {
#     "policy_version": "policy/sbom-required/v1",
#     "author": "<you>",
#     "shapes_format": "shacl-turtle",
#     "shapes": "<contents of this file>",
#     "require_sbom": true
#   }

<urn:policy:sbom-placeholder> a sh:NodeShape ;
    sh:targetClass <urn:sg:entity-type:SKILL_VERSION> ;
    sh:property [
        sh:path <urn:sg:property:sbom_placeholder> ;
        sh:minCount 0 ;
        sh:message "placeholder_shape_never_fires" ;
    ] .
