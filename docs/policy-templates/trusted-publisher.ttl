@prefix sh: <http://www.w3.org/ns/shacl#> .

# Template: trusted-publisher
#
# A gate policy: certifying a version is blocked unless every valid
# detached signature is owned by a trusted publisher key (the key's
# owner_label must match the publication's publisher).
#
# The shapes slot is required for every authored policy; this starts with a
# no-op shape — replace or extend it with real constraints as the policy
# grows.
#
# Register with:
#   POST /v1/policy-packages
#   {
#     "policy_version": "policy/trusted-publisher/v1",
#     "author": "<you>",
#     "shapes_format": "shacl-turtle",
#     "shapes": "<contents of this file>",
#     "require_trusted_publisher": true
#   }

<urn:policy:trusted-publisher-placeholder> a sh:NodeShape ;
    sh:targetClass <urn:sg:entity-type:SKILL_VERSION> ;
    sh:property [
        sh:path <urn:sg:property:trusted_publisher_placeholder> ;
        sh:minCount 0 ;
        sh:message "placeholder_shape_never_fires" ;
    ] .
