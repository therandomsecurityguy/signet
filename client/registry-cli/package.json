{
  "name": "@signet-registry/operator",
  "version": "0.1.3",
  "description": "Operator/assistant CLI for the Signet registry: bootstrap, seed, and verify agents and skills.",
  "license": "BSD-3-Clause",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therandomsecurityguy/signet.git",
    "directory": "client/registry-cli"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "registry-operator": "dist/main.js"
  },
  "main": "dist/main.js",
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "scripts": {
    "dev": "node --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@sigstore/bundle": "^5.0.0",
    "@sigstore/core": "^4.0.1",
    "@sigstore/sign": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9"
  }
}
