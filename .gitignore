**/node_modules/
**/dist/
**/.terraform/
**/.terraform.lock.hcl

.idea/

data/*.db

# Per-service local SQLite state.
service/*/var/*.db

tools/vocbench/downloads/*
tools/vocbench/runtime/*
tools/vocbench/data/*
.cookies/*

# Local runtime state and operator scratch outputs.
data/**/*.db
data/registry/graph/
data/registry/objects/
data/registry-operator/**/resume.json
data/registry-operator/**/report-*.json
data/registry-operator/adhoc-pack/
data/registry-operator/bootstrap-pack-test/
# Ephemeral demo signing key generated by `seed bootstrap` when signing is on.
data/registry-operator/demo-signing-key.pem

# CLI release tarballs (build artifacts).
client/registry-cli/release/*.tgz

!tools/vocbench/downloads/.gitkeep
!tools/vocbench/runtime/.gitkeep
!tools/vocbench/data/.gitkeep
!.cookies/.gitkeep

# Keyless test fixtures are generated at test time (test-only keys are never committed).
service/api/tests/fixtures/keyless/
client/registry-cli/tests/fixtures/keyless/

# Compiled Go binary from local builds.
/service/tessera-runtime/tessera-runtime

# Local demo runtime state (scripts/demo-local.sh).
data/demo/

# Demo-video recordings and webapp-local runtime state.
service/webapp/knowledge-manager/data/

# Python (service/shacl-runtime).
__pycache__/
.pytest_cache/
service/shacl-runtime/.venv/
