# Native companion log (RFC 6962): set a PEM private key (TESSERA_LOG_PRIVATE_KEY)
# or a spec note key (TESSERA_LOG_NOTE_KEY=PRIVATE+KEY+<name>+<hash8hex>+<base64>)
# to enable append + signed checkpoints; mutually exclusive. The registry
# verifies them with TESSERA_LOG_PUBLIC_KEY (legacy) or TESSERA_LOG_NOTE_VERIFIER
# (spec). Generate a note key with: node scripts/make-tessera-note-key.mjs <origin>
TESSERA_LOG_ORIGIN=signet-tessera.local
VOCBENCH_PORT=1979
